# --- Nexora Tool Bot configuration ---

BOT_TOKEN=your_botfather_token_here

# Comma-separated Telegram user IDs allowed to use this bot. Each entry can
# optionally carry a name label: id or id:Name (e.g. 123456789:Atif).
# Leave blank to allow anyone. Get your own ID by sending /id to your bot.
# Easiest managed from the Nexora Tool Bot Admin Portal web panel instead of editing this by hand.
# This whitelist is shared across ALL tools in the bot, not per-tool.
ALLOWED_USER_IDS=

# Shown to users in the generic fallback message when something goes wrong
# and the bot can't give a more specific reply (e.g. "message @yourhandle").
# Only used if the phone's connection is up enough to send that reply at
# all — if it's genuinely offline, nothing can respond until it's back.
OWNER_CONTACT=Atif

# --- Nexo Link2video tool ---

# Optional: path to a Netscape-format cookies file exported from a logged-in
# Instagram session in your browser. Needed if Instagram starts rate-limiting
# anonymous requests. Leave blank to skip.
INSTAGRAM_COOKIES_FILE=

# Max file size (MB) to send back via the standard Telegram Bot API.
# Bot API hard limit is 50MB unless you run a local Bot API server.
MAX_FILE_SIZE_MB=50

# --- Optional web control panel (webui.py) ---
# Host to bind the web UI to. Keep as 127.0.0.1 to only allow access from
# the phone's own browser. Set to 0.0.0.0 to allow other devices on your
# WiFi to reach it too — if you do, you MUST also set WEBUI_PASSWORD below.
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8080

# Password required to use the web UI (HTTP Basic Auth, any username).
# Leave blank only if WEBUI_HOST stays 127.0.0.1.
WEBUI_PASSWORD=
